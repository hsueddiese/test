# Copy to .env and fill in your values
SUMMARY_RECIPIENT=you@gmail.com
GMAIL_CREDENTIALS_PATH=credentials.json   # OAuth2 client secret from Google Cloud Console
GMAIL_TOKEN_PATH=token.json               # auto-created after first login
MAX_RESULTS=20                            # max emails per search category

# --- Home Assistant ---
HA_URL=https://myhome.duckdns.org         # public URL of your Home Assistant
HA_TOKEN=                                 # Long-Lived Access Token (Profile -> Security)
