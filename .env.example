# Copy to .env and fill in your values
SUMMARY_RECIPIENT=you@gmail.com
GMAIL_CREDENTIALS_PATH=credentials.json   # OAuth2 client secret from Google Cloud Console
GMAIL_TOKEN_PATH=token.json               # auto-created after first login
MAX_RESULTS=20                            # max emails per search category

# --- Home Assistant status query (ha_status.py) ---
HA_URL=http://192.168.1.50:8123           # base URL of your Home Assistant instance
HA_TOKEN=                                 # Long-Lived Access Token (Profile -> Long-Lived Access Tokens)
HA_ENTITIES=                              # optional, comma-separated e.g. sensor.temperature,light.living_room
